    <!-- ===== Summer TV 设计 token（UI 重构阶段 A，取值来自定稿样稿） =====
         新代码只引用 st_* 语义色；主色继续用主题属性 ?attr/color_theme（随主题切换）。
         上面以十六进制命名的旧颜色名与实际取值已经对不上，例如：
           color_32364E 是页面背景（阶段 B 起改为 #0B0E12，与 st_bg 一致），color_3D3D3D 实际是 #1A2027（卡片）。
         旧名暂时保留，页面在阶段 B/C 重做时逐个改用 st_*，不做一次性全量替换。 -->
    <color name="st_bg">#0B0E12</color>
    <!-- 主色（与默认"夏日"主题 color_theme 相同）；弹窗等不继承应用主题的地方直接引用 -->
    <color name="st_accent">#FF8A50</color>
    <color name="st_bg_elevated">#12161C</color>
    <!-- 叠在模糊背景上的半透明层：7% / 14% 白 -->
    <color name="st_surface">#12FFFFFF</color>
    <color name="st_surface_strong">#24FFFFFF</color>
    <!-- 卡片 1px 内描边：8% 白 -->
    <color name="st_card_stroke">#2EFFFFFF</color>
    <color name="st_stroke">#14FFFFFF</color>
    <color name="st_text_primary">#F5F7FA</color>
    <color name="st_text_secondary">#A8B0BA</color>
    <!-- 海报片名未聚焦态：比主文字略暗，但明显亮于副文字 -->
    <color name="st_text_title_idle">#E4E8ED</color>
    <color name="st_text_tertiary">#6B7480</color>
    <!-- 主色填充（焦点按钮、评分角标）上的文字色 -->
    <color name="st_on_accent">#1A0E07</color>
    <!-- Hero / 详情背景的渐变遮罩：分别为 82% 与 55% 不透明的 st_bg -->
