<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_480"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/st_dialog_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_35"
        android:paddingTop="@dimen/vs_30"
        android:paddingRight="@dimen/vs_35"
        android:paddingBottom="@dimen/vs_30">

        <TextView
            android:id="@+id/confirmation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_25"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/dia_confirm"
            android:textAppearance="@style/TextAppearance.Summer.Title"
            tools:text="@string/dia_confirm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="@dimen/st_button_height_compact"
                android:layout_marginEnd="@dimen/vs_12"
                android:layout_marginRight="@dimen/vs_12"
                android:layout_weight="1"
                android:background="@drawable/st_button_pill_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/dia_yes"
                android:textColor="@color/st_button_primary_text"
                android:textSize="@dimen/st_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/st_button_height_compact"
                android:layout_marginStart="@dimen/vs_12"
                android:layout_marginLeft="@dimen/vs_12"
                android:layout_weight="1"
                android:background="@drawable/st_button_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/dia_no"
                android:textColor="@color/st_button_text"
                android:textSize="@dimen/st_text_body"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
