<?xml version="1.0" encoding="utf-8"?>
<!-- 单击海报智能优选可播源的轻量等待浮层 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_460"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/st_dialog_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_35"
        android:paddingTop="@dimen/vs_30"
        android:paddingRight="@dimen/vs_35"
        android:paddingBottom="@dimen/vs_30">

        <ProgressBar
            android:layout_width="@dimen/vs_45"
            android:layout_height="@dimen/vs_45"
            android:indeterminateBehavior="repeat"
            android:indeterminateDrawable="@drawable/anim_loading"
            android:indeterminateOnly="true" />

        <TextView
            android:id="@+id/tvResolveTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Summer.Title" />

        <TextView
            android:id="@+id/tvResolveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/smart_resolving"
            android:textColor="@color/st_text_secondary"
            android:textSize="@dimen/st_text_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_12"
            android:text="@string/smart_cancel_hint"
            android:textAppearance="@style/TextAppearance.Summer.Caption"
            android:textColor="@color/st_text_tertiary" />
    </LinearLayout>
</FrameLayout>
