<?xml version="1.0" encoding="utf-8"?>
<!-- 收藏夹页面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_60"
        android:paddingTop="@dimen/vs_30"
        android:paddingRight="@dimen/vs_60"
        android:paddingBottom="@dimen/vs_10">

        <View
            android:layout_width="@dimen/vs_5"
            android:layout_height="@dimen/vs_30"
            android:layout_marginEnd="@dimen/vs_14"
            android:layout_marginRight="@dimen/vs_14"
            android:background="@drawable/st_accent_bar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_50"
            android:drawablePadding="@dimen/vs_10"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/act_fav"
            android:textColor="@color/st_text_primary"
            android:textSize="@dimen/ts_30" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDelTip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_50"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/vs_10"
            android:layout_marginEnd="@dimen/vs_14"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:text="@string/act_fav_sel"
            android:textColor="@color/st_accent"
            android:textSize="@dimen/st_text_body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDelete"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/st_pill_height"
            android:layout_marginEnd="@dimen/vs_12"
            android:layout_marginRight="@dimen/vs_12"
            android:background="@drawable/st_button_pill"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:paddingLeft="@dimen/st_button_padding_h"
            android:paddingRight="@dimen/st_button_padding_h"
            android:singleLine="true"
            android:text="@string/act_search_del"
            android:textColor="@color/st_button_text"
            android:textSize="@dimen/st_text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvClear"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/st_pill_height"
            android:background="@drawable/st_button_pill"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:paddingLeft="@dimen/st_button_padding_h"
            android:paddingRight="@dimen/st_button_padding_h"
            android:singleLine="true"
            android:text="@string/act_search_clr"
            android:textColor="@color/st_button_text"
            android:textSize="@dimen/st_text_body"
            android:textStyle="bold" />

    </LinearLayout>

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/mGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/vs_60"
        android:paddingTop="@dimen/vs_20"
        android:paddingRight="@dimen/vs_60"
        android:paddingBottom="@dimen/vs_40"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_20"
        app:tv_selectedItemIsCentered="true"
        app:tv_verticalSpacingWithMargins="@dimen/vs_20" />
</LinearLayout>
