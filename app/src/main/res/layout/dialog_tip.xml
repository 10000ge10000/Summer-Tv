<?xml version="1.0" encoding="utf-8"?>
<!-- 通用提示弹窗（TipDialog）：v1.0.20 改用 st_* 深色 token。
     原布局是深色背景配 80% 黑字，几乎看不见。正文过长时可上下滚动。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/st_dialog_bg"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_40"
        android:paddingTop="@dimen/vs_30"
        android:paddingRight="@dimen/vs_40"
        android:paddingBottom="@dimen/vs_30">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:focusable="false"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tipInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.35"
                android:textColor="@color/st_text_primary"
                android:textSize="@dimen/st_text_body"
                tools:text="发现新版本 1.0.20" />
        </ScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_30"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/leftBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/st_button_height_compact"
                android:layout_marginRight="@dimen/vs_14"
                android:background="@drawable/st_button_pill"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/vs_120"
                android:paddingLeft="@dimen/st_button_padding_h"
                android:paddingRight="@dimen/st_button_padding_h"
                android:text="确定"
                android:textColor="@color/st_button_text"
                android:textSize="@dimen/st_text_body" />

            <TextView
                android:id="@+id/rightBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/st_button_height_compact"
                android:layout_marginLeft="@dimen/vs_14"
                android:background="@drawable/st_button_pill"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/vs_120"
                android:paddingLeft="@dimen/st_button_padding_h"
                android:paddingRight="@dimen/st_button_padding_h"
                android:text="取消"
                android:textColor="@color/st_button_text"
                android:textSize="@dimen/st_text_body" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
