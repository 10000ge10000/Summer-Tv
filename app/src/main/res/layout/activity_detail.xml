<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页（UI 重构阶段 C）：保留全部控件 id 与左侧海报 / 预览播放器位置，
     改为海报模糊背景、大标题、胶囊按钮、胶囊线路与圆角选集格子 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_bg">

    <!-- 海报模糊背景：两层交叉淡入 + 遮罩，不参与焦点 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/ivAmbientA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivAmbientB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/st_backdrop_scrim" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_50"
            android:paddingRight="@dimen/vs_50"
            android:paddingBottom="@dimen/vs_10">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="@dimen/st_detail_poster_width"
                android:layout_height="@dimen/st_detail_poster_height"
                android:clickable="true"
                android:elevation="@dimen/vs_8"
                android:focusable="false"
                android:scaleType="fitXY" />

            <View
                android:id="@+id/previewPlayerPlace"
                android:layout_width="@dimen/vs_530"
                android:layout_height="@dimen/vs_300"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/st_detail_poster_height"
                android:layout_marginStart="@dimen/vs_30"
                android:layout_marginLeft="@dimen/vs_30"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/st_text_primary"
                    android:textSize="@dimen/st_text_detail_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/vs_14"
                        android:layout_marginRight="@dimen/vs_14"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:background="@drawable/st_meta_chip"
                        android:paddingLeft="@dimen/vs_8"
                        android:paddingRight="@dimen/vs_8"
                        android:textColor="@color/st_text_secondary"
                        android:textSize="@dimen/st_text_detail_meta" />
                    <TextView
                        android:id="@+id/tvYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/vs_14"
                        android:layout_marginRight="@dimen/vs_14"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/st_text_secondary"
                        android:textSize="@dimen/st_text_detail_meta" />
                    <TextView
                        android:id="@+id/tvArea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/vs_14"
                        android:layout_marginRight="@dimen/vs_14"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/st_text_secondary"
                        android:textSize="@dimen/st_text_detail_meta" />
                    <TextView
                        android:id="@+id/tvLang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/vs_14"
                        android:layout_marginRight="@dimen/vs_14"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/st_text_secondary"
                        android:textSize="@dimen/st_text_detail_meta" />
                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/vs_14"
                        android:layout_marginRight="@dimen/vs_14"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/st_text_secondary"
                        android:textSize="@dimen/st_text_detail_meta" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_4"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/st_text_secondary"
                    android:textSize="@dimen/st_text_detail_meta" />

                <TextView
                    android:id="@+id/tvDirector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_4"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/st_text_secondary"
                    android:textSize="@dimen/st_text_detail_meta" />

                <!-- 简介占用按钮行之外的剩余高度；能显示几整行由 DetailActivity 在布局后计算，
                     避免手机大字号下把按钮行挤出去、或最后一行只露出半截 -->
                <TextView
                    android:id="@+id/tvDes"
                    android:layout_width="match_parent"
                    android:layout_height="0mm"
                    android:layout_marginTop="@dimen/vs_8"
                    android:layout_marginBottom="@dimen/vs_8"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="top"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="3"
                    android:textColor="@color/st_text_secondary"
                    android:textSize="@dimen/st_text_detail_meta" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPlay"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/st_button_height_compact"
                        android:layout_marginEnd="@dimen/vs_12"
                        android:layout_marginRight="@dimen/vs_12"
                        android:background="@drawable/st_button_pill_primary"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="@dimen/vs_100"
                        android:paddingLeft="@dimen/st_button_padding_h"
                        android:paddingRight="@dimen/st_button_padding_h"
                        android:singleLine="true"
                        android:text="@string/det_play"
                        android:textColor="@color/st_button_text"
                        android:textSize="@dimen/st_text_tab"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuickSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/st_button_height_compact"
                        android:layout_marginEnd="@dimen/vs_12"
                        android:layout_marginRight="@dimen/vs_12"
                        android:background="@drawable/st_button_pill"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="@dimen/vs_100"
                        android:paddingLeft="@dimen/st_button_padding_h"
                        android:paddingRight="@dimen/st_button_padding_h"
                        android:singleLine="true"
                        android:text="@string/det_search"
                        android:textColor="@color/st_button_text"
                        android:textSize="@dimen/st_text_tab"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSort"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/st_button_height_compact"
                        android:layout_marginEnd="@dimen/vs_12"
                        android:layout_marginRight="@dimen/vs_12"
                        android:background="@drawable/st_button_pill"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="@dimen/vs_100"
                        android:paddingLeft="@dimen/st_button_padding_h"
                        android:paddingRight="@dimen/st_button_padding_h"
                        android:singleLine="true"
                        android:text="@string/det_sort"
                        android:textColor="@color/st_button_text"
                        android:textSize="@dimen/st_text_tab"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPush"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/st_button_height_compact"
                        android:layout_marginEnd="@dimen/vs_12"
                        android:layout_marginRight="@dimen/vs_12"
                        android:background="@drawable/st_button_pill"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="@dimen/vs_100"
                        android:paddingLeft="@dimen/st_button_padding_h"
                        android:paddingRight="@dimen/st_button_padding_h"
                        android:singleLine="true"
                        android:text="@string/det_push"
                        android:textColor="@color/st_button_text"
                        android:textSize="@dimen/st_text_tab"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/st_button_height_compact"
                        android:layout_marginEnd="@dimen/vs_12"
                        android:layout_marginRight="@dimen/vs_12"
                        android:background="@drawable/st_button_pill"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="@dimen/vs_100"
                        android:paddingLeft="@dimen/st_button_padding_h"
                        android:paddingRight="@dimen/st_button_padding_h"
                        android:singleLine="true"
                        android:text="@string/det_desc"
                        android:textColor="@color/st_button_text"
                        android:textSize="@dimen/st_text_tab"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCollect"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/st_button_height_compact"
                        android:layout_marginEnd="@dimen/vs_12"
                        android:layout_marginRight="@dimen/vs_12"
                        android:background="@drawable/st_button_pill"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="@dimen/vs_100"
                        android:paddingLeft="@dimen/st_button_padding_h"
                        android:paddingRight="@dimen/st_button_padding_h"
                        android:singleLine="true"
                        android:text="@string/det_fav"
                        android:textColor="@color/st_button_text"
                        android:textSize="@dimen/st_text_tab"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/tvPlayUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/vs_6"
                        android:layout_marginLeft="@dimen/vs_6"
                        android:focusable="false"
                        app:srcCompat="@drawable/button_detail_link" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/mEmptyPlaylist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            tools:visibility="gone">

            <ImageView
                android:layout_width="@dimen/vs_128"
                android:layout_height="@dimen/vs_128"
                android:layout_gravity="center"
                android:alpha="0.6"
                android:src="@drawable/icon_empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_marginLeft="@dimen/vs_10"
                android:gravity="center"
                android:text="暂无播放数据"
                android:textColor="@color/st_text_secondary"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridViewFlag"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_50"
            android:layout_marginTop="@dimen/vs_10"
            android:layout_marginRight="@dimen/vs_50"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
            app:tv_selectedItemIsCentered="true" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mSeriesGroupView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_50"
            android:layout_marginTop="@dimen/vs_4"
            android:layout_marginRight="@dimen/vs_50"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
            app:tv_selectedItemIsCentered="true" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_50"
            android:layout_marginTop="@dimen/vs_10"
            android:layout_marginRight="@dimen/vs_50"
            android:layout_marginBottom="@dimen/vs_30"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_10" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="@dimen/vs_530"
        android:layout_height="@dimen/vs_300"
        android:layout_marginStart="@dimen/vs_50"
        android:layout_marginLeft="@dimen/vs_50"
        android:layout_marginTop="@dimen/vs_20"
        android:visibility="gone" />

    <View
        android:id="@+id/previewPlayerBlock"
        android:layout_width="@dimen/vs_530"
        android:layout_height="@dimen/vs_300"
        android:layout_marginStart="@dimen/vs_50"
        android:layout_marginLeft="@dimen/vs_50"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/button_detail_preview"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
