<?xml version="1.0" encoding="utf-8"?>
<!-- 首次使用声明弹窗：标题 + 可滚动正文 + 两个按钮。高度固定在一屏内，正文过长时上下键滚动 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_720"
        android:layout_height="@dimen/vs_600"
        android:layout_gravity="center"
        android:background="@drawable/st_dialog_bg"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_40"
        android:paddingTop="@dimen/vs_30"
        android:paddingRight="@dimen/vs_40"
        android:paddingBottom="@dimen/vs_30">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disclaimer_title"
            android:textColor="@color/st_text_primary"
            android:textSize="@dimen/st_text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/disclaimerBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_20"
            android:layout_weight="1"
            android:background="@drawable/st_disclaimer_body_bg"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:lineSpacingMultiplier="1.35"
            android:nextFocusDown="@+id/disclaimerAgree"
            android:padding="@dimen/vs_14"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:text="@string/disclaimer_body"
            android:textColor="@color/st_text_secondary"
            android:textSize="@dimen/st_text_body" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_20"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/disclaimerExit"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/st_button_height_compact"
                android:layout_marginRight="@dimen/vs_14"
                android:background="@drawable/st_button_pill"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/vs_120"
                android:nextFocusUp="@id/disclaimerBody"
                android:paddingLeft="@dimen/st_button_padding_h"
                android:paddingRight="@dimen/st_button_padding_h"
                android:text="@string/disclaimer_exit"
                android:textColor="@color/st_button_text"
                android:textSize="@dimen/st_text_body" />

            <TextView
                android:id="@+id/disclaimerAgree"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/st_button_height_compact"
                android:layout_marginLeft="@dimen/vs_14"
                android:background="@drawable/st_button_pill"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/vs_120"
                android:nextFocusUp="@id/disclaimerBody"
                android:paddingLeft="@dimen/st_button_padding_h"
                android:paddingRight="@dimen/st_button_padding_h"
                android:text="@string/disclaimer_agree"
                android:textColor="@color/st_button_text"
                android:textSize="@dimen/st_text_body" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
