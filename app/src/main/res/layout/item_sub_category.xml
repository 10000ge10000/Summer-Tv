<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/vs_5"
    android:background="@drawable/button_sub_category"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:paddingLeft="@dimen/vs_15"
    android:paddingTop="@dimen/vs_8"
    android:paddingRight="@dimen/vs_15"
    android:paddingBottom="@dimen/vs_8">

    <TextView
        android:id="@+id/subCategoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF_70"
        android:textSize="@dimen/ts_24" />
</LinearLayout>
