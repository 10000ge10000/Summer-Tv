<?xml version="1.0" encoding="utf-8"?>
<!-- 首页首屏 Hero（首页二次重构）：今日推荐占满首屏——左侧片名、信息、简介和播放按钮，右侧竖版海报，
     背景是 HomeActivity 的模糊氛围层。高度由 UserFragment 设为列表完整可见高度（整屏），
     顶部让出浮动顶栏；随列表自然滚走，不再隐藏。快捷入口已移到 HomeActivity 左侧导航栏。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heroRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/heroBlock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_60"
        android:paddingTop="@dimen/st_top_bar_offset"
        android:paddingRight="@dimen/vs_30"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingRight="@dimen/vs_40">

            <TextView
                android:id="@+id/heroEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:singleLine="true"
                android:textColor="?attr/color_theme"
                android:textSize="@dimen/st_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:ellipsize="end"
                android:maxWidth="@dimen/st_hero_text_max_width"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Summer.Display" />

            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:ellipsize="end"
                android:maxWidth="@dimen/st_hero_text_max_width"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Summer.Label"
                android:textColor="@color/st_text_primary" />

            <TextView
                android:id="@+id/heroIntro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_14"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                android:maxWidth="@dimen/st_hero_text_max_width"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.Summer.Body"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/heroActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_30"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/heroPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_button_height"
                    android:background="@drawable/st_button_pill_primary"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="@dimen/vs_150"
                    android:nextFocusUp="@id/mGridViewCategory"
                    android:paddingLeft="@dimen/st_button_padding_h"
                    android:paddingRight="@dimen/st_button_padding_h"
                    android:singleLine="true"
                    android:text="@string/hm_hero_play"
                    android:textColor="@color/st_button_text"
                    android:textSize="@dimen/st_text_tab"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <com.github.tvbox.osc.ui.tv.widget.RoundClipFrameLayout
            android:id="@+id/heroPosterFrame"
            android:layout_width="@dimen/st_hero_poster_width"
            android:layout_height="@dimen/st_hero_poster_height"
            android:background="@drawable/st_card_frame_bg"
            android:focusable="false">

            <ImageView
                android:id="@+id/heroPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </com.github.tvbox.osc.ui.tv.widget.RoundClipFrameLayout>
    </LinearLayout>
</FrameLayout>
