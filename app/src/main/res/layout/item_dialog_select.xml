<?xml version="1.0" encoding="utf-8"?>
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tvName"
    android:layout_width="match_parent"
    android:layout_height="@dimen/st_button_height_compact"
    android:layout_gravity="center"
    android:background="@drawable/st_button_pill"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:paddingLeft="@dimen/st_button_padding_h"
    android:paddingRight="@dimen/st_button_padding_h"
    android:singleLine="true"
    android:text="@{name}"
    android:textColor="@color/st_button_text"
    android:textSize="@dimen/st_text_tab"
    tools:text="Source Name" />
