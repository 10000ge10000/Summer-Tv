<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_460"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/st_dialog_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/vs_30">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="@dimen/st_button_height_compact"
            android:layout_marginEnd="@dimen/vs_12"
            android:layout_marginRight="@dimen/vs_12"
            android:layout_weight="1"
            android:background="@drawable/input_search"
            android:hint="请输入密码"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_14"
            android:paddingRight="@dimen/vs_14"
            android:textColor="@color/st_text_primary"
            android:textColorHint="@color/st_text_tertiary"
            android:textSize="@dimen/st_text_body" />

        <TextView
            android:id="@+id/inputSubmit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/st_button_height_compact"
            android:background="@drawable/st_button_pill_primary"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/st_button_padding_h"
            android:paddingRight="@dimen/st_button_padding_h"
            android:text="@string/dia_yes"
            android:textColor="@color/st_button_primary_text"
            android:textSize="@dimen/st_text_body"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
