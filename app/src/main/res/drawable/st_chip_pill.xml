<?xml version="1.0" encoding="utf-8"?>
<!-- 线路 / 分组胶囊：聚焦浅色实心，当前选中半透明加强，默认半透明 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_pill" />
            <solid android:color="@color/st_text_primary" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_pill" />
            <solid android:color="@color/st_surface_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_pill" />
            <solid android:color="@color/st_surface" />
        </shape>
    </item>
</selector>
