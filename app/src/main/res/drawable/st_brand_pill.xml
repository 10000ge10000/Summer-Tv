<?xml version="1.0" encoding="utf-8"?>
<!-- 首页左上角品牌入口胶囊（图标 + Summer TV 字标一体聚焦） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_pill" />
            <solid android:color="@color/st_surface_strong" />
            <stroke android:width="@dimen/st_focus_stroke" android:color="?attr/color_theme" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_pill" />
            <solid android:color="@color/st_surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_pill" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
