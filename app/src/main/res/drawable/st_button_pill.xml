<?xml version="1.0" encoding="utf-8"?>
<!-- 通用胶囊按钮（详情页操作区等）：聚焦为浅色实心，默认半透明 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_pill" />
            <solid android:color="@color/st_text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_pill" />
            <solid android:color="@color/st_surface_strong" />
        </shape>
    </item>
</selector>
