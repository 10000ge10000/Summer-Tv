<?xml version="1.0" encoding="utf-8"?>
<!-- 通用聚焦背景：搜索页按钮与键盘、推送页、列表条目共用。
     UI 重构阶段 C：聚焦为主题色实心（使用处文字均为白色，浅色底会看不清），默认为半透明圆角 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_card" />
            <solid android:color="?attr/color_theme" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_card" />
            <solid android:color="?attr/color_theme_40" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/st_radius_card" />
            <solid android:color="@color/st_surface" />
        </shape>
    </item>
</selector>
